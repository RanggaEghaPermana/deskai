{
  "language": "en",
  "default_mode": "social",
  "dock": {
    "autohide": "windows",
    "reserve_space": true,
    "show_running": true,
    "icon_size": 38
  },
  "motion": {
    "enabled": true,
    "style": "smooth"
  },
  "inbox": {
    "enabled": true,
    "messages": [
      "WhatsApp"
    ],
    "agent_apps": [
      "com.anthropic.Claude.desktop",
      "chatgpt.desktop",
      "antigravity.desktop",
      "antigravity-ide.desktop",
      "cursor.desktop"
    ]
  },
  "llm": {
    "backend": "auto",
    "model": "claude-opus-5-5",
    "effort": "low",
    "triage_notifications": true,
    "exclude_apps": [
      "org.keepassxc.KeePassXC.desktop",
      "bitwarden.desktop",
      "1password.desktop"
    ]
  },
  "modes": {
    "writing": {
      "label": "Writing",
      "icon": "document-edit-symbolic",
      "color": "#e8833a",
      "focus": true,
      "description": "Long writing: a thesis, reports, articles, documentation. Research in the browser is fine as long as it serves the text.",
      "apps": [
        "google-chrome.desktop",
        "libreoffice-writer.desktop",
        "com.anthropic.Claude.desktop"
      ],
      "allow": [
        "docs.google.com",
        "Google Docs",
        "Overleaf",
        "Notion",
        "Obsidian",
        "Google Scholar",
        "Zotero",
        "Mendeley",
        "LibreOffice Writer",
        "Grammarly",
        "KBBI",
        "WhatsApp"
      ],
      "block": [
        "YouTube",
        "Instagram",
        "TikTok",
        "Twitter",
        " / X",
        " on X:",
        "Reddit",
        "Facebook",
        "Discord",
        "Netflix",
        "Twitch",
        "Shopee",
        "Tokopedia"
      ],
      "notifications": {
        "policy": "filter",
        "allow_apps": [
          "Calendar",
          "Clocks"
        ],
        "keywords": [
          "urgent",
          "darurat",
          "penting banget",
          "asap",
          "OTP",
          "kode verifikasi"
        ]
      },
      "exit": {
        "delay": 10,
        "per_press": 3
      },
      "nudge_after": 45,
      "on_distraction": "nudge"
    },
    "building": {
      "label": "Building",
      "icon": "applications-engineering-symbolic",
      "color": "#3b82f6",
      "focus": true,
      "description": "Coding: writing and debugging code, reading documentation, the terminal, AI coding agents, GitHub, testing on localhost.",
      "apps": [
        "antigravity.desktop",
        "org.gnome.Ptyxis.desktop",
        "google-chrome.desktop",
        "com.anthropic.Claude.desktop",
        "org.gnome.Terminal.desktop",
        "org.gnome.Console.desktop",
        "code.desktop"
      ],
      "allow": [
        "localhost",
        "127.0.0.1",
        "GitHub",
        "GitLab",
        "Stack Overflow",
        "laravel.com",
        "Laracasts",
        "react.dev",
        "MDN",
        "npm",
        "Packagist",
        "Vite",
        "Tailwind",
        "Claude",
        "Postman",
        "phpMyAdmin",
        "Antigravity",
        "WhatsApp"
      ],
      "block": [
        "Instagram",
        "TikTok",
        "Twitter",
        " / X",
        " on X:",
        "Reddit",
        "Facebook",
        "Discord",
        "Netflix",
        "Twitch",
        "Shopee",
        "Tokopedia"
      ],
      "notifications": {
        "policy": "filter",
        "allow_apps": [
          "Calendar"
        ],
        "keywords": [
          "urgent",
          "darurat",
          "server down",
          "build failed",
          "deploy",
          "OTP"
        ]
      },
      "exit": {
        "delay": 10,
        "per_press": 3
      },
      "nudge_after": 60,
      "on_distraction": "nudge"
    },
    "studying": {
      "label": "Studying",
      "icon": "accessories-dictionary-symbolic",
      "color": "#10b981",
      "focus": true,
      "description": "Studying: course material, e-learning, lectures or tutorials that fit the subject, practice problems. Educational videos on YouTube are fine.",
      "apps": [
        "google-chrome.desktop",
        "firefox_firefox.desktop",
        "firefox.desktop",
        "libreoffice-writer.desktop"
      ],
      "allow": [
        "Google Classroom",
        "e-learning",
        "elearning",
        "Moodle",
        "SPADA",
        "Coursera",
        "Dicoding",
        "Google Scholar",
        ".pdf",
        "Google Drive",
        "WhatsApp"
      ],
      "block": [
        "Instagram",
        "TikTok",
        "Twitter",
        " / X",
        " on X:",
        "Reddit",
        "Facebook",
        "Discord",
        "Netflix",
        "Twitch",
        "Shopee",
        "Tokopedia"
      ],
      "notifications": {
        "policy": "filter",
        "allow_apps": [
          "Calendar",
          "Clocks"
        ],
        "keywords": [
          "urgent",
          "darurat",
          "kuis",
          "deadline",
          "OTP"
        ]
      },
      "exit": {
        "delay": 10,
        "per_press": 3
      },
      "nudge_after": 60,
      "on_distraction": "nudge"
    },
    "social": {
      "label": "Social",
      "icon": "chat-message-new-symbolic",
      "color": "#e5484d",
      "focus": false,
      "description": "Time off: chat, social media, YouTube, entertainment. No rules, notifications as usual.",
      "apps": [
        "discord_discord.desktop",
        "google-chrome.desktop",
        "firefox_firefox.desktop",
        "firefox.desktop"
      ],
      "allow": [
        "WhatsApp",
        "Discord",
        "Telegram",
        "Instagram",
        "TikTok",
        "Twitter",
        " / X",
        " on X:",
        "Reddit",
        "YouTube",
        "Facebook",
        "Netflix",
        "Twitch"
      ],
      "notifications": {
        "policy": "all"
      }
    }
  }
}
